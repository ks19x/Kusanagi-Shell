post_install() {
  cat <<'MSG'
==> Kusanagi is installed. Every user sets it up once: run  kusanagi  in a terminal.
    It asks which compositors start Kusanagi and which keys to use, then starts the shell,
    whose Setup walks you through the rest. Run it again any time:  kusanagi install
==> Check what's missing on this system:  kusanagi doctor
==> The login screen (optional, needs greetd and cage):  kusanagi greeter install
MSG
}

post_upgrade() {
  echo '==> Restart a running Kusanagi to use the new version:  kusanagi restart'
}
