	depends = libnotify
	depends = python
	depends = slurp
	depends = ttf-jetbrains-mono-nerd
	depends = wl-clipboard
	optdepends = pipewire: audio (volume, mic, recording sound)
	optdepends = wireplumber: PipeWire session manager
	optdepends = xdg-desktop-portal-gtk: file pickers, screen sharing
	optdepends = networkmanager: the Wi-Fi / network panel
	optdepends = bluez: Bluetooth
	optdepends = bluez-utils: Bluetooth (bluetoothctl)
	optdepends = python-gobject: pairing Bluetooth devices with a code
	optdepends = gammastep: night light
	optdepends = gamemode: game mode
	optdepends = gpu-screen-recorder: screen recording, replays, streaming
	optdepends = wf-recorder: screen recording without replays
	optdepends = ddcutil: brightness of external monitors
	optdepends = swappy: editing screenshots
	optdepends = hyprlock: the hyprlock lock screen engine
	optdepends = pavucontrol: the full audio mixer
	optdepends = wtype: typing emoji from the launcher
	optdepends = fd: faster file search
	optdepends = pacman-contrib: the update count (checkupdates)
	optdepends = noto-fonts-emoji: emoji in the launcher
	optdepends = foot: a terminal
	optdepends = greetd: the Kusanagi login screen
	optdepends = cage: the Kusanagi login screen
	optdepends = quickshell: the legacy QML engine (kusanagi engine qml)
	optdepends = mangowm: a compositor Kusanagi sets up
	optdepends = hyprland: a compositor Kusanagi sets up
	optdepends = niri: a compositor Kusanagi sets up
	optdepends = sway: a compositor Kusanagi sets up
	optdepends = labwc: a compositor Kusanagi sets up
	provides = kusanagi=0.2.0
	conflicts = kusanagi
	source = kusanagi::git+https://github.com/ks19x/Kusanagi-Shell.git
	sha256sums = SKIP

pkgname = kusanagi-git
