	url = https://github.com/ks19x/Kusanagi-Shell
	install = kusanagi.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = meson
	makedepends = ninja
	makedepends = nlohmann-json
	makedepends = stb
	makedepends = wayland-protocols
