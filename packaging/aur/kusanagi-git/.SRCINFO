	depends = curl
	depends = fontconfig
	depends = freetype2
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = harfbuzz
	depends = jemalloc
	depends = libglvnd
	depends = libical
	depends = libjxl
	depends = libpipewire
	depends = libqalculate
	depends = librsvg
	depends = libsecret
	depends = libsndfile
	depends = libsodium
	depends = libwebp
	depends = libwireplumber
	depends = libxkbcommon
	depends = libxml2
	depends = md4c
	depends = pam
	depends = pango
	depends = polkit
	depends = sdbus-cpp
	depends = tomlplusplus
	depends = wayland
	depends = cliphist
	depends = grim
