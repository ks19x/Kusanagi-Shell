# Maintainer: ks19x <326228137+ks19x@users.noreply.github.com>
# Prebuilt from the GitHub release (built in an archlinux container by .github/workflows/release.yml).
# New version: bump pkgver, run updpkgsums (or paste the release's .sha256), makepkg --printsrcinfo > .SRCINFO.

pkgname=kusanagi-bin
_name=kusanagi
pkgver=0.3.0
pkgrel=1
pkgdesc='Desktop shell for Wayland: bar, launcher, control panel, notifications, wallpapers, lock screen (prebuilt)'
arch=('x86_64')
url='https://github.com/ks19x/Kusanagi-Shell'
license=('MIT')
depends=(
  # what kusanagi-shell links
  'cairo' 'curl' 'fontconfig' 'freetype2' 'gcc-libs' 'glib2' 'glibc' 'harfbuzz' 'jemalloc'
  'libglvnd' 'libical' 'libjxl' 'libpipewire' 'libqalculate' 'librsvg' 'libsecret' 'libsndfile'
  'libsodium' 'libwebp' 'libwireplumber' 'libxkbcommon' 'libxml2' 'md4c' 'pam' 'pango' 'polkit'
  'sdbus-cpp' 'tomlplusplus' 'wayland'
  # what the kusanagi command and the shell run
  'cliphist' 'grim' 'imagemagick' 'libnotify' 'python' 'slurp' 'ttf-jetbrains-mono-nerd' 'wl-clipboard'
)
optdepends=(
  'pipewire: audio (volume, mic, recording sound)'
  'wireplumber: PipeWire session manager'
  'xdg-desktop-portal-gtk: file pickers, screen sharing'
  'networkmanager: the Wi-Fi / network panel'
  'bluez: Bluetooth'
  'bluez-utils: Bluetooth (bluetoothctl)'
  'python-gobject: pairing Bluetooth devices with a code'
  'gammastep: night light'
  'gamemode: game mode'
  'gpu-screen-recorder: screen recording, replays, streaming'
  'wf-recorder: screen recording without replays'
  'ddcutil: brightness of external monitors'
  'swappy: editing screenshots'
  'hyprlock: the hyprlock lock screen engine'
  'pavucontrol: the full audio mixer'
  'wtype: typing emoji from the launcher'
  'fd: faster file search'
  'pacman-contrib: the update count (checkupdates)'
  'noto-fonts-emoji: emoji in the launcher'
  'foot: a terminal'
  'greetd: the Kusanagi login screen'
  'cage: the Kusanagi login screen'
  'quickshell: the legacy QML engine (kusanagi engine qml)'
  'mangowm: a compositor Kusanagi sets up'
  'hyprland: a compositor Kusanagi sets up'
  'niri: a compositor Kusanagi sets up'
  'sway: a compositor Kusanagi sets up'
  'labwc: a compositor Kusanagi sets up'
)
provides=("$_name=$pkgver")
conflicts=("$_name")
options=('!strip' '!debug')
install=$_name.install
source_x86_64=("$url/releases/download/v$pkgver/$_name-$pkgver-x86_64.tar.zst")
sha256sums_x86_64=('SKIP')

package() {
  cp -a --no-preserve=ownership "$srcdir/$_name-$pkgver-$CARCH/usr" "$pkgdir/"
}
