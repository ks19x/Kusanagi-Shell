#!/bin/sh
# kusanagi — sig's desktop shell (Quickshell/QML), as one command.
#   kusanagi [start]            start it (detached, lean memory settings) — does nothing if it's running
#   kusanagi stop | restart     stop / restart it
#   kusanagi status [-q]        is it running? (-q: exit code only)
#   kusanagi msg <target> <fn> [args]   talk to the running shell, e.g.  kusanagi msg launcher toggle
#   kusanagi ipc                list every target and function msg understands
#   kusanagi preset [name|next|list]    apply a look (default: list them)
#   kusanagi look export <name>         write ~/kusanagi-looks/<name>.kusanagi (share it)
#   kusanagi look import <file>         apply a shared look (ones that run commands: review in Settings)
#   kusanagi greeter install|sync|preview|status|uninstall   the login screen (greetd); install needs sudo once
#   kusanagi session <compositor …>   start a desktop session (the login screen uses it): its own D-Bus,
#                               a runtime folder, a log in ~/.local/state/kusanagi/sessions, one retry
#   kusanagi settings [page]    open Settings (optionally on a page: bar, presets, wallpaper…)
#   kusanagi log [-f]           the current log (-f follows it)
#   kusanagi wallpaper [file|restore|get]   set the wallpaper (and re-colour everything from it)
#   kusanagi screenshot [region|full] · kusanagi colorpick
#   kusanagi edit               open settings.json in your editor
#   kusanagi doctor             check everything Kusanagi uses (packages, session, conflicts) + how to fix it
#   kusanagi updates [count|list|upgrade]   available updates (no root): the number · "name<TAB>source"
#                               lines · upgrade everything in a terminal. Cached in ~/.cache/kusanagi/updates
#   kusanagi record replay|save|record|stream|stop|status   screen recording (status: one line of JSON)
#   kusanagi brightness [up|down|<percent>|get|setup]    screen brightness (laptop panel, DDC/CI monitors);
#                               setup installs ddcutil + i2c access for monitors (sudo once)
#   kusanagi bluetooth [toggle|on|off|status|setup]      Bluetooth; setup installs BlueZ and starts it (sudo once)
#   kusanagi distro family|install-cmd …|updates|upgrade-cmd|storage   distro helpers (lib/distro.sh)
#   kusanagi setup              open the first-run setup
#   kusanagi version | help
set -u

ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
SHELL_DIR="$ROOT/shell"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kusanagi"
VERSION=$(cat "$ROOT/VERSION" 2>/dev/null || echo dev)
WALL="$CONF/wallpaper"                    # path of the current wallpaper
HOOK="$CONF/hooks/wallpaper"              # optional: run after a wallpaper change (gets the path)

qsp() { qs -p "$SHELL_DIR" "$@"; }
# a wedged instance mustn't hang us: every probe gets 2 s
running() { timeout 2 qs -p "$SHELL_DIR" ipc show >/dev/null 2>&1; }
instance_pids() { pgrep -f "^qs -p $SHELL_DIR\$"; }
die() { echo "kusanagi: $*" >&2; exit 1; }

# set the wallpaper: remember it, build colours from it, run the user's hook (e.g. re-theme a rice)
wallpaper_set() {
    f=$(readlink -f "$1") || die "no such file: $1"
    [ -f "$f" ] || die "no such file: $1"
    mkdir -p "$CONF"
    printf '%s\n' "$f" > "$WALL"
    python3 "$ROOT/lib/palette.py" "$f" "$CONF/colors.json" 2>/dev/null || echo "kusanagi: couldn't build colours (needs python3 + ImageMagick)" >&2
    [ -x "$HOOK" ] && "$HOOK" "$f" >/dev/null 2>&1 &
    # renderer "awww" (Settings → Wallpaper): hand the picture to awww instead of drawing it ourselves
    if grep -q '"renderer": "awww"' "$CONF/settings.json" 2>/dev/null && command -v awww >/dev/null; then
        pgrep -x awww-daemon >/dev/null || { setsid -f awww-daemon >/dev/null 2>&1 </dev/null; sleep 0.3; }
        awww img "$f" -t random --transition-duration 1 >/dev/null 2>&1 &
    fi
    return 0
}

# first run: pick up a wallpaper from an older setup, and make sure colours exist
first_run() {
    mkdir -p "$CONF"
    if [ ! -s "$WALL" ]; then
        for old in "$HOME/.config/rices/zei/current-wallpaper" "$HOME/.cache/wal/wal"; do
            [ -s "$old" ] && { head -1 "$old" > "$WALL"; break; }
        done
    fi
    if [ ! -s "$CONF/colors.json" ] && [ -s "$WALL" ]; then
        python3 "$ROOT/lib/palette.py" "$(cat "$WALL")" "$CONF/colors.json" 2>/dev/null || true
    fi
}

# Qt draws through Vulkan where there's a hardware Vulkan driver: same pixels as OpenGL, ~11 MB less RAM
# and ~25% less CPU while things animate. Qt doesn't fall back by itself (no driver = no shell), so a
# start that dies under Vulkan is retried on OpenGL and remembered. KUSANAGI_RENDERER=opengl|vulkan forces one.
RHI_NOTE="${XDG_STATE_HOME:-$HOME/.local/state}/kusanagi/renderer"
vulkan_driver() {
    for d in /etc/vulkan/icd.d /usr/share/vulkan/icd.d /usr/local/share/vulkan/icd.d; do
        for f in "$d"/*.json; do
            [ -e "$f" ] || continue
            case ${f##*/} in lvp_*|lavapipe*) ;; *) return 0 ;; esac     # lavapipe = software: no
        done
    done
    return 1
}
renderer() {
    case ${KUSANAGI_RENDERER:-} in opengl|vulkan) echo "$KUSANAGI_RENDERER"; return ;; esac
    [ "$(cat "$RHI_NOTE" 2>/dev/null)" = opengl ] && { echo opengl; return; }
    vulkan_driver && echo vulkan || echo opengl
}

launch() {
    # threaded renderer = smooth animations; jemalloc told to hand freed memory straight back
    QSG_RHI_BACKEND=$1 QSG_RENDER_LOOP=threaded \
    MALLOC_CONF=narenas:1,tcache:false,dirty_decay_ms:0,muzzy_decay_ms:0,retain:false \
        setsid -f qs -p "$SHELL_DIR" >/dev/null 2>&1 </dev/null
    i=0; while [ $i -lt 30 ] && ! running; do sleep 0.1; i=$((i + 1)); done
    running || return 1
    # a broken Vulkan driver answers IPC first and dies on its first window
    [ "$1" = vulkan ] && { sleep 1; [ -n "$(instance_pids)" ] && running; }
}

start() {
    running && { echo "kusanagi is already running"; return 0; }
    [ -n "$(instance_pids)" ] && stop >/dev/null     # there but not answering: replace it
    first_run
    command -v qs >/dev/null || die "quickshell (qs) isn't installed"
    r=$(renderer)
    if ! launch "$r" && [ "$r" = vulkan ] && [ -z "${KUSANAGI_RENDERER:-}" ]; then
        pids=$(instance_pids); [ -n "$pids" ] && kill $pids 2>/dev/null
        mkdir -p "${RHI_NOTE%/*}"; echo opengl > "$RHI_NOTE"
        echo "kusanagi: Vulkan didn't work here — using OpenGL from now on" >&2
        r=opengl; launch opengl
    fi
    running && echo "kusanagi $VERSION started ($r)" || die "didn't come up — see: kusanagi log"
}

stop() {
    [ -n "$(instance_pids)" ] || { echo "kusanagi isn't running"; return 0; }
    timeout 3 qs -p "$SHELL_DIR" kill >/dev/null 2>&1
    i=0; while [ $i -lt 20 ] && [ -n "$(instance_pids)" ]; do sleep 0.1; i=$((i + 1)); done
    # still there (wedged): make sure it goes
    pids=$(instance_pids); [ -n "$pids" ] && { kill $pids 2>/dev/null; sleep 0.5; pids=$(instance_pids); [ -n "$pids" ] && kill -9 $pids 2>/dev/null; }
    echo "kusanagi stopped"
}

# ---------------------------------------------------------------- doctor / updates
DISTRO="$ROOT/lib/distro.sh"
# a value from settings.json by dotted path (look.font, idle.enabled) — "" if unset
setting() {
    f="$CONF/settings.json"; [ -r "$f" ] || return 0
    if command -v python3 >/dev/null; then
        python3 -c 'import json, sys
d = json.load(open(sys.argv[1]))
for k in sys.argv[2].split("."): d = d.get(k) if isinstance(d, dict) else None
print("" if d is None else str(d).lower() if isinstance(d, bool) else d)' "$f" "$1" 2>/dev/null
    else sed -n "s/.*\"${1##*.}\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\).*/\1/p" "$f" | head -n 1; fi
}
term_cmd() {   # the user's terminal: $TERMINAL, launcher.terminal, or the first one installed
    for t in "${TERMINAL:-}" "$(setting launcher.terminal)" foot kitty alacritty wezterm ghostty konsole xterm; do
        [ -n "$t" ] && command -v "${t%% *}" >/dev/null && { echo "$t"; return 0; }
    done
    return 1
}
# run a shell snippet in the user's terminal (detached)
in_term() {
    t=$(term_cmd) || return 1
    # shellcheck disable=SC2086
    case "${t%% *}" in
        foot|kitty)            setsid -f $t sh -c "$1" >/dev/null 2>&1 </dev/null ;;
        wezterm)               setsid -f $t start -- sh -c "$1" >/dev/null 2>&1 </dev/null ;;
        gnome-terminal|ptyxis) setsid -f $t -- sh -c "$1" >/dev/null 2>&1 </dev/null ;;
        *)                     setsid -f $t -e sh -c "$1" >/dev/null 2>&1 </dev/null ;;
    esac
}

# ---------------------------------------------------------------- one-time setups that need root
# show what will run as root, ask, run it. From Settings (no terminal) it reopens itself in one.
root_steps() {   # $1 = title, $2 = the commands (one per line, already prefixed with sudo/doas where needed)
    if ! [ -t 0 ]; then
        in_term "'$ROOT/bin/kusanagi' $SETUP_CMD; echo; echo 'press Enter to close'; read x" || die "no terminal found — run: kusanagi $SETUP_CMD"
        exit 0
    fi
    [ -n "$2" ] || { echo "$1: nothing to do — all set."; return 1; }
    printf '%s — this will run:\n\n' "$1"; printf '%s\n' "$2" | sed 's/^/    /'
    printf '\nGo ahead? [Y/n] '; read -r a
    case "$a" in n*|N*) echo "nothing changed"; exit 1 ;; esac
    printf '%s\n' "$2" | while IFS= read -r c; do echo "→ $c"; sh -c "$c" </dev/tty || { echo "failed: $c"; exit 1; }; done || exit 1
}
SU=$( [ "$(id -u)" = 0 ] && echo "" || { command -v doas >/dev/null && ! command -v sudo >/dev/null && echo "doas " || echo "sudo "; } )

brightness_setup() {
    SETUP_CMD="brightness setup"
    steps=""
    command -v ddcutil >/dev/null || steps=$(sh "$DISTRO" install-cmd ddcutil | grep -v '^#')
    [ -e /sys/module/i2c_dev ] || steps="$steps
${SU}modprobe i2c-dev"
    # load it at every boot (systemd, runit/Void, OpenRC and dinit all read modules-load.d)
    grep -qsx i2c-dev /etc/modules-load.d/*.conf || steps="$steps
echo i2c-dev | ${SU}tee /etc/modules-load.d/i2c-dev.conf >/dev/null"
    # /dev/i2c-*: for the person at the seat right away (uaccess), and the i2c group after the next login
    rule=/etc/udev/rules.d/60-kusanagi-i2c.rules
    if [ ! -e "$rule" ]; then steps="$steps
printf '%s\\n' 'KERNEL==\"i2c-[0-9]*\", SUBSYSTEM==\"i2c-dev\", GROUP=\"i2c\", MODE=\"0660\", TAG+=\"uaccess\"' | ${SU}tee $rule >/dev/null
${SU}groupadd -f -r i2c
${SU}usermod -aG i2c $(id -un)
${SU}udevadm control --reload
${SU}udevadm trigger --subsystem-match=i2c-dev --action=add"
    fi
    steps=$(printf '%s\n' "$steps" | sed '/^$/d')
    root_steps "Monitor brightness (DDC/CI)" "$steps" || true
    qsp ipc call brightness detect >/dev/null 2>&1
    echo "done. Your monitors also need DDC/CI switched on in their own menu (usually on by default)."
    ok=0; for b in /dev/i2c-*; do [ -r "$b" ] && [ -w "$b" ] && ok=1; done
    [ $ok = 1 ] || echo "If brightness still can't reach them: log out and back in (the i2c group)."
}

bluetooth_setup() {
    SETUP_CMD="bluetooth setup"
    pk=""
    { command -v bluetoothctl >/dev/null || command -v bluetoothd >/dev/null || [ -x /usr/libexec/bluetooth/bluetoothd ] || [ -x /usr/lib/bluetooth/bluetoothd ]; } || pk="bluez"
    python3 -c 'import gi' 2>/dev/null || pk="$pk gi"           # the pairing helper (codes / PINs)
    steps=""
    # shellcheck disable=SC2086
    [ -n "$pk" ] && steps=$(sh "$DISTRO" install-cmd $pk | grep -v '^#')
    root_steps "Bluetooth: packages" "$steps" || true
    steps=$(sh "$DISTRO" service-cmd bluetooth bluetoothd) || { echo "couldn't find the Bluetooth service for your init — start bluetoothd yourself"; return 1; }
    command -v rfkill >/dev/null && rfkill list bluetooth 2>/dev/null | grep -q 'Soft blocked: yes' && steps="$steps
${SU}rfkill unblock bluetooth"
    steps=$(printf '%s\n' "$steps" | sed '/^$/d')
    root_steps "Bluetooth: the service" "$steps" || true
    sleep 1
    if [ -z "$(ls /sys/class/bluetooth 2>/dev/null)" ]; then echo "Bluetooth is set up, but there's no adapter in this computer (a USB dongle works)."
    else echo "done — Bluetooth is in the control panel (BT tab) and Settings → Bluetooth."; fi
}

doctor() {
    if [ -t 1 ]; then G=$(printf '\033[32m'); Rd=$(printf '\033[31m'); Y=$(printf '\033[33m'); D=$(printf '\033[2m'); B=$(printf '\033[1m'); N=$(printf '\033[0m')
    else G=""; Rd=""; Y=""; D=""; B=""; N=""; fi
    fam=$(sh "$DISTRO" family 2>/dev/null); req=0; want=""
    ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$1"; }
    note() { printf '  %s·%s %s\n' "$D" "$N" "$1"; }
    warn() { printf '  %s!%s %s\n' "$Y" "$N" "$1"; }
    bad()  { printf '  %s✗%s %s\n' "$Rd" "$N" "$1"; }
    fix()  { [ "${2:-}" = opt ] || want="$want $1"; sh "$DISTRO" install-cmd "$1" 2>/dev/null | sed "s/^/      $D→ /;s/\$/$N/"; }
    has()  { for c in "$@"; do command -v "$c" >/dev/null && return 0; done; return 1; }
    # check <group> <logical> <label> <commands…>  (group: req | rec | opt — opt's label says what it gives you)
    check() {
        g=$1; l=$2; lab=$3; shift 3
        if has "$@"; then ok "$lab"; return 0; fi
        case "$g" in req) bad "$lab ${D}(missing — required)$N"; req=$((req + 1)) ;; rec) bad "$lab ${D}(missing)$N" ;; opt) note "$lab ${D}(not installed)$N" ;; esac
        fix "$l" "$g"; return 1
    }
    run() { pgrep -x "$1" >/dev/null 2>&1; }

    printf '%sKusanagi %s%s — %s (%s)\n' "$B" "$VERSION" "$N" "$(. "${KUSANAGI_OS_RELEASE:-/etc/os-release}" 2>/dev/null; echo "${PRETTY_NAME:-${ID:-unknown}}")" "$fam"
    [ "$fam" = nixos ] && warn "NixOS: the fixes below are package names for your configuration.nix"

    printf '\n%sRequired%s\n' "$B" "$N"
    check req quickshell "quickshell (qs)" qs quickshell
    check req python "python3 — colours from the wallpaper, settings tools" python3
    check req wl-clipboard "wl-clipboard (wl-copy)" wl-copy
    font=$(setting look.font); [ -n "$font" ] || font="JetBrainsMono Nerd Font"
    if ! command -v fc-list >/dev/null; then bad "fontconfig (fc-list) — can't check fonts"; req=$((req + 1))
    elif fc-list : family | grep -qiF "$font"; then ok "font: $font"
    elif fc-list : family | grep -qi "JetBrainsMono Nerd"; then warn "font: $font isn't installed (look.font) — JetBrainsMono Nerd Font is, so that's used"
    else bad "font: $font ${D}(missing — a Nerd Font is required for the icons)$N"; req=$((req + 1)); fix font; fi

    printf '\n%sRecommended%s\n' "$B" "$N"
    check rec cliphist "cliphist — clipboard history" cliphist
    check rec grim "grim — screenshots" grim
    check rec slurp "slurp — region screenshots, colour picker" slurp
    check rec magick "ImageMagick — wallpaper colours, thumbnails" magick convert
    check rec libnotify "notify-send — notifications from scripts" notify-send
    check rec gammastep "gammastep — night light" gammastep
    check rec pavucontrol "pavucontrol — the full audio mixer" pavucontrol
    check rec nm "NetworkManager (nmcli) — Wi-Fi / network panel" nmcli
    if ! command -v fc-list >/dev/null || fc-list : family | grep -qiE "emoji"; then ok "an emoji font"
    else bad "an emoji font ${D}(missing — emoji show as boxes in the launcher and apps)$N"; fix emoji; fi
    if t=$(term_cmd); then ok "terminal: $t"; else bad "a terminal ${D}(none found — set \$TERMINAL or launcher.terminal)$N"; fix foot; fi
    case $(renderer) in
        vulkan) ok "renderer: Vulkan" ;;
        *) if vulkan_driver; then note "renderer: OpenGL ${D}(Vulkan failed here once — rm $RHI_NOTE to try again)$N"
           else note "renderer: OpenGL ${D}(a Vulkan driver would save ~10 MB and some CPU — mesa-vulkan-drivers / vulkan-radeon / vulkan-intel)$N"; fi ;;
    esac

    printf '\n%sOptional%s\n' "$B" "$N"
    if has gpu-screen-recorder gsr-ui || { has flatpak && flatpak info com.dec05eba.gpu_screen_recorder >/dev/null 2>&1; }; then
        ok "gpu-screen-recorder — recording, replays, streaming$(has gsr-ui && echo ' (gsr-ui too)')"
    else note "gpu-screen-recorder — recording, replays, streaming ${D}(not installed)$N"; fix gpu-screen-recorder opt; fi
    check opt wf-recorder "wf-recorder — recording fallback (no replays)" wf-recorder
    check opt wtype "wtype — type emoji from the launcher" wtype
    check opt gamemode "gamemoded — game mode performance" gamemoded
    check opt swappy "swappy — edit screenshots" swappy
    check opt hyprlock "hyprlock — the default lock engine" hyprlock
    check opt fd "fd — faster file search" fd fdfind
    if command -v ddcutil >/dev/null; then
        ok=0; for b in /dev/i2c-*; do [ -r "$b" ] && [ -w "$b" ] && ok=1; done
        if [ ! -e /sys/module/i2c_dev ]; then warn "ddcutil — monitor brightness ${D}(the i2c-dev module isn't loaded — run: kusanagi brightness setup)$N"
        elif [ $ok = 0 ]; then warn "ddcutil — monitor brightness ${D}(no access to /dev/i2c-* — run: kusanagi brightness setup, then log in again)$N"
        else ok "ddcutil — monitor brightness"; fi
    elif [ -n "$(ls /sys/class/backlight 2>/dev/null)" ]; then ok "brightness: built-in display ${D}(ddcutil would add external monitors)$N"
    else note "ddcutil — monitor brightness ${D}(not installed — kusanagi brightness setup)$N"; fi
    if [ -z "$(ls /sys/class/bluetooth 2>/dev/null)" ]; then note "Bluetooth ${D}(no adapter in this computer)$N"
    elif ! pgrep -x bluetoothd >/dev/null; then warn "Bluetooth ${D}(there's an adapter, but bluetoothd isn't running — kusanagi bluetooth setup)$N"
    elif ! python3 -c 'import gi' 2>/dev/null; then warn "Bluetooth ${D}(works; PyGObject would let phones / keyboards pair with a code — kusanagi bluetooth setup)$N"
    else ok "Bluetooth"; fi
    [ "$fam" = arch ] && check opt checkupdates "checkupdates (pacman-contrib) — the update count" checkupdates

    printf '\n%sSession%s\n' "$B" "$N"
    if [ -n "${MANGO_INSTANCE_SIGNATURE:-}" ] || { command -v mmsg >/dev/null && run mango; }; then ok "compositor: mango"
    elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then ok "compositor: Hyprland"
    elif [ -n "${NIRI_SOCKET:-}" ]; then ok "compositor: niri"
    elif [ -n "${WAYLAND_DISPLAY:-}" ]; then warn "compositor: ${XDG_CURRENT_DESKTOP:-unknown} — Kusanagi knows mango, Hyprland and niri best"
    else note "no Wayland session here (run this from inside your desktop for the session checks)"; fi
    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then ok "D-Bus session bus"
    else bad "no D-Bus session bus ${D}— start the compositor with dbus-run-session (kusanagi session does)$N"; fi
    if run pipewire; then ok "PipeWire running$(run wireplumber || echo " ${Y}(but no wireplumber)$N")"
    else bad "PipeWire isn't running ${D}— volume, mic and recording audio need it$N"; has pipewire || fix pipewire; fi
    if run polkitd; then ok "polkit daemon"
    elif [ -x /usr/lib/polkit-1/polkitd ] || [ -x /usr/libexec/polkitd ] || [ -x /usr/lib/polkit/polkitd ]; then warn "polkit is installed but polkitd isn't running ${D}(enable its service, or dbus starts it on demand)$N"
    else bad "polkit ${D}(missing — password prompts for apps)$N"; fix polkit; fi
    agents=$(pgrep -af 'polkit-gnome-authentication-agent-1|lxpolkit|polkit-kde-authentication-agent-1|hyprpolkitagent|polkit-mate-authentication-agent-1|mate-polkit|xfce-polkit' 2>/dev/null | awk '{ n = $2; sub(/.*\//, "", n); print n }' | sort -u | paste -sd' ' -)
    [ -n "$agents" ] && warn "another polkit agent is running ($agents) — it blocks Kusanagi's own; drop it from your autostart"
    idlers=""; for i in hypridle swayidle; do run $i && idlers="$idlers $i"; done
    if [ -n "$idlers" ]; then
        if [ "$(setting idle.enabled)" = true ]; then warn "${idlers# } is running and Kusanagi's idle is on — the screen will be locked/blanked twice; pick one"
        else note "idle handled by${idlers}"; fi
    fi
    notifd=""; for i in mako dunst swaync fnott; do run $i && notifd="$notifd $i"; done
    [ -n "$notifd" ] && warn "${notifd# } is running — it takes the notifications Kusanagi would show"
    if pgrep -f '(^|/)xdg-desktop-portal( |$)' >/dev/null 2>&1; then ok "xdg-desktop-portal"
    else warn "xdg-desktop-portal isn't running ${D}— file pickers, screen sharing, portal recording$N"; fi
    if running; then ok "Kusanagi is running"; else note "Kusanagi isn't running (kusanagi start)"; fi
    if sh "$ROOT/lib/greeter.sh" installed 2>/dev/null; then ok "login screen: installed"; else note "login screen: not installed (kusanagi greeter install)"; fi
    # the last session that ended: if it crashed, show how
    ld=${XDG_STATE_HOME:-$HOME/.local/state}/kusanagi/sessions; last=""; lt=0
    for f in "$ld"/*.log "$ld"/*.log.old; do
        [ -f "$f" ] || continue
        grep '^== ' "$f" | tail -n 1 | grep -q ' exited [0-9]* after ' || continue
        t=$(stat -c %Y "$f" 2>/dev/null || echo 0); [ "$t" -gt "$lt" ] && { lt=$t; last=$f; }
    done
    if [ -n "$last" ]; then
        rc=$(grep '^== ' "$last" | tail -n 1 | sed -n 's/.* exited \([0-9]*\) after.*/\1/p')
        if [ "${rc:-0}" != 0 ]; then warn "the last session ($(basename "$last")) ended with exit $rc:"; tail -n 8 "$last" | sed "s/^/      $D/;s/\$/$N/"
        else note "last session ($(basename "$last")) ended cleanly"; fi
    fi

    echo
    if [ -n "$want" ]; then
        printf '%sInstall what'"'"'s missing (required + recommended):%s\n' "$B" "$N"
        # shellcheck disable=SC2086
        sh "$DISTRO" install-cmd $want 2>/dev/null | sed 's/^/  /'
    fi
    if [ $req = 0 ]; then printf '%s✓%s everything Kusanagi needs is here\n' "$G" "$N"; return 0
    else printf '%s✗%s %s required thing(s) missing\n' "$Rd" "$N" "$req"; return 1; fi
}
updates() {   # updates [count|list|upgrade]
    uc=${XDG_CACHE_HOME:-$HOME/.cache}/kusanagi
    case "${1:-count}" in
        count|list|raw)
            mkdir -p "$uc"
            r=$(sh "$DISTRO" updates); rc=$?
            printf '%s\n' "$r" >"$uc/updates.tmp" && mv -f "$uc/updates.tmp" "$uc/updates"
            date +%s >"$uc/updates.time"
            case "${1:-count}" in
                count) printf '%s\n' "$r" | head -n 1 ;;
                raw)   printf '%s\n' "$r" ;;              # count, then the list (the shell reads this)
                *)     printf '%s\n' "$r" | tail -n +2 ;;
            esac
            return $rc ;;
        upgrade)
            c=$(sh "$DISTRO" upgrade-cmd) || die "don't know how to upgrade this distro"
            # afterwards: refresh the cached count so the bar catches up
            in_term "$c; echo; '$ROOT/bin/kusanagi' updates count >/dev/null 2>&1; echo 'Done — press Enter'; read x" \
                || die "no terminal found — run it yourself: $c"
            echo "upgrading in a terminal: $c" ;;
        *) die "usage: kusanagi updates [count|list|upgrade]" ;;
    esac
}

cmd=${1:-start}; [ $# -gt 0 ] && shift
case "$cmd" in
    start)    start ;;
    stop)     stop ;;
    restart)  stop >/dev/null; start ;;
    status)   if running; then [ "${1:-}" = -q ] || echo "kusanagi $VERSION is running"; exit 0
              else [ "${1:-}" = -q ] || echo "kusanagi isn't running"; exit 1; fi ;;
    msg)      [ $# -ge 2 ] || die "usage: kusanagi msg <target> <function> [args]  (see: kusanagi ipc)"
              qsp ipc call "$@" ;;
    ipc)      qsp ipc show ;;
    preset)   case "${1:-list}" in
                  list) sed -n 's/^ *id: "\([^"]*\)", name: "\([^"]*\)", note: "\([^"]*\)".*/  \1\t\2 — \3/p' "$SHELL_DIR/Presets.qml" ;;
                  next) qsp ipc call preset next ;;
                  *)    qsp ipc call preset apply "$1" ;;
              esac ;;
    greeter)  G="$ROOT/lib/greeter.sh"
              case "${1:-status}" in
                  install)   command -v greetd >/dev/null || die "greetd isn't installed (it's the login daemon this uses)"
                             echo "Kusanagi needs root once to: install cage if missing, create /var/lib/kusanagi-greeter,"
                             echo "write /usr/local/bin/kusanagi-greeter and point /etc/greetd/config.toml at it (old one kept)."
                             sudo sh "$G" root-install "$(id -un)" || exit 1
                             sh "$G" sync "$SHELL_DIR"
                             echo "Done. greetd reads its config when it starts, so you'll see it after a reboot."
                             echo "(Restarting greetd now would end a session you logged in to through it.)" ;;
                  uninstall) sudo sh "$G" root-uninstall ;;
                  sync)      sh "$G" sync "$SHELL_DIR" "${2:-}" ;;
                  preview)   if [ -f /var/lib/kusanagi-greeter/shell/greeter.qml ] && [ -r /var/lib/kusanagi-greeter/.config/kusanagi/settings.json ]; then
                                 HOME=/var/lib/kusanagi-greeter XDG_CONFIG_HOME=/var/lib/kusanagi-greeter/.config setsid qs -p /var/lib/kusanagi-greeter/shell/greeter.qml >/dev/null 2>&1 &
                             else setsid qs -p "$SHELL_DIR/greeter.qml" >/dev/null 2>&1 & fi ;;
                  status)    if sh "$G" installed; then echo "installed: greetd starts kusanagi-greeter"; else echo "not installed (greetd uses: $(sed -n '/^\[default_session\]/,/^\[/{s/^[[:space:]]*command[[:space:]]*=[[:space:]]*//p}' /etc/greetd/config.toml 2>/dev/null))"; fi
                             [ -d /var/lib/kusanagi-greeter/shell ] && echo "synced: $(stat -c %y /var/lib/kusanagi-greeter/shell | cut -d. -f1)"
                             gu=$(sed -n '/^\[default_session\]/,/^\[/{s/^[[:space:]]*user[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p}' /etc/greetd/config.toml 2>/dev/null)
                             [ -S /run/seatd.sock ] && [ -n "$gu" ] && ! id -nG "$gu" 2>/dev/null | tr ' ' '\n' | grep -qx _seatd && echo "note: $gu isn't in group _seatd — run: kusanagi greeter install"
                             [ -r /tmp/kusanagi-greeter.log ] && { echo "last start:"; sed 's/^/  /' /tmp/kusanagi-greeter.log | tail -15; }; true ;;
                  *)         die "usage: kusanagi greeter install | sync | preview | status | uninstall" ;;
              esac ;;
    session)  [ $# -ge 1 ] || die "usage: kusanagi session <compositor command…>"
              logdir=${XDG_STATE_HOME:-$HOME/.local/state}/kusanagi/sessions
              mkdir -p "$logdir"
              log="$logdir/$(basename "$1").log"
              [ -f "$log" ] && mv -f "$log" "$log.old"
              { echo "== $(date '+%F %T') starting: $*"; env | grep -E '^(XDG_|DBUS_|WAYLAND|DISPLAY=)' | sort; } > "$log"
              # compositors refuse to start without a runtime folder
              if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "${XDG_RUNTIME_DIR:-/nonexistent}" ] || [ ! -w "${XDG_RUNTIME_DIR:-/nonexistent}" ]; then
                  r=/run/user/$(id -u)
                  if [ ! -d "$r" ] || [ ! -w "$r" ]; then r=/tmp/runtime-$(id -u); mkdir -p "$r" && chmod 700 "$r"; fi
                  echo "== XDG_RUNTIME_DIR '${XDG_RUNTIME_DIR:-}' was unusable, using $r" >> "$log"
                  export XDG_RUNTIME_DIR="$r"
              fi
              export XDG_SESSION_TYPE=wayland
              # the login screen picks this session (and you) first next time — `greeter sync` reads it
              [ -n "${XDG_SESSION_DESKTOP:-}" ] && printf '%s\n' "$XDG_SESSION_DESKTOP" > "$logdir/../last-session"
              # every session on its own D-Bus (unless one is already there)
              if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null; then set -- dbus-run-session "$@"; fi
              tries=0
              while :; do
                  t0=$(date +%s)
                  "$@" >> "$log" 2>&1
                  rc=$?
                  echo "== $(date '+%F %T') exited $rc after $(( $(date +%s) - t0 )) s" >> "$log"
                  # gone at once with an error — usually the GPU / seat not handed over yet: one more try
                  if [ $rc -ne 0 ] && [ $(( $(date +%s) - t0 )) -lt 5 ] && [ $tries -lt 1 ]; then tries=1; sleep 1; echo "== retrying" >> "$log"; continue; fi
                  exit $rc
              done ;;
    look)     case "${1:-}" in
                  export) [ $# -ge 2 ] || die "usage: kusanagi look export <name>"; qsp ipc call preset exportLook "$2" ;;
                  import) [ $# -ge 2 ] || die "usage: kusanagi look import <file>"
                          f=$(readlink -f "$2") || die "no such file: $2"; qsp ipc call preset importLook "$f" ;;
                  *)      die "usage: kusanagi look export <name> | import <file>" ;;
              esac ;;
    settings) if [ $# -ge 1 ]; then qsp ipc call settings page "$1"; else qsp ipc call settings open; fi ;;
    log)      f=""; for d in $(ls -t /run/user/"$(id -u)"/quickshell/by-id/*/log.qslog 2>/dev/null); do
                  qs log "$d" 2>/dev/null | head -3 | grep -q "$SHELL_DIR" && { f=$d; break; }; done
              [ -n "$f" ] || die "no log found (is it running?)"
              if [ "${1:-}" = -f ]; then qs log -f "$f"; else qs log "$f"; fi ;;
    wallpaper) case "${1:-get}" in
                  get)     cat "$WALL" 2>/dev/null ;;
                  restore) [ -s "$WALL" ] && wallpaper_set "$(cat "$WALL")" ;;
                  pick)    qsp ipc call wallpaper toggle ;;
                  *)       wallpaper_set "$1" ;;
              esac ;;
    screenshot) exec "$ROOT/scripts/screenshot" "${1:-region}" ;;
    colorpick)  exec "$ROOT/scripts/colorpick" ;;
    edit)     ${VISUAL:-${EDITOR:-mousepad}} "$CONF/settings.json" ;;
    doctor)   doctor ;;
    updates)  updates "$@" ;;
    setup)    qsp ipc call setup open ;;
    record)   exec "$ROOT/scripts/record" "$@" ;;
    brightness) case "${1:-get}" in
                  setup)            brightness_setup ;;
                  up|down|get|detect) qsp ipc call brightness "$1" ;;
                  set)              [ $# -ge 2 ] || die "usage: kusanagi brightness set <percent>"; qsp ipc call brightness set "${2%\%}" ;;
                  [0-9]*)           qsp ipc call brightness set "${1%\%}" ;;
                  *)                die "usage: kusanagi brightness [up|down|<percent>|get|setup]" ;;
              esac ;;
    bluetooth) case "${1:-status}" in
                  setup)                 bluetooth_setup ;;
                  toggle|on|off|status)  qsp ipc call bluetooth "$1" ;;
                  *)                     die "usage: kusanagi bluetooth [toggle|on|off|status|setup]" ;;
              esac ;;
    distro)   exec sh "$DISTRO" "$@" ;;
    version|-v|--version) echo "kusanagi $VERSION" ;;
    help|-h|--help) sed -n '2,/^set -u$/{/^#/s/^# \{0,1\}//p}' "$0" ;;
    *)        die "unknown command '$cmd' — try: kusanagi help" ;;
esac
